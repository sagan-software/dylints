// run-rustfix
// rustfix-only-machine-applicable

fn adjacent(values: &[i32]) {
    // Trigger for the non-panicking range with two adjacent slice indexes.
    for window in values.windows(2) {
        println!(
            "{current} {next}",
            current = window[0],
            next = window[1]
        );
    }
}

fn owned(values: Vec<i32>) -> i32 {
    // Trigger for an owned `Vec` and indexes in reverse order.
    let mut total = 0;
    for window in values.windows(2) {
        total += window[1] - window[0];
    }
    total
}

fn array(values: [i32; 3]) -> i32 {
    // Trigger for an array and indexes inside a closure.
    let mut total = 0;
    for window in values.windows(2) {
        let sum = || window[0] + window[1];
        total += sum();
    }
    total
}

fn unsafe_bound(values: &[i32]) {
    // Keep quiet when the empty input case can underflow before iteration.
    for index in 0..values.len() - 1 {
        println!(
            "{current} {next}",
            current = values[index],
            next = values[index + 1]
        );
    }
}

fn uses_index(values: &[i32]) {
    // Keep quiet when the body also uses the index value.
    for index in 0..values.len().saturating_sub(1) {
        println!("{index} {} {}", values[index], values[index + 1]);
    }
}

fn different_slices(values: &[i32], other: &[i32]) {
    // Keep quiet when the indexes read different slices.
    for index in 0..values.len().saturating_sub(1) {
        println!("{} {}", values[index], other[index + 1]);
    }
}

fn repeated_index(values: &[i32]) {
    // Keep quiet when both indexes read the same element.
    for index in 0..values.len().saturating_sub(1) {
        println!("{} {}", values[index], values[index]);
    }
}

fn extra_index(values: &[i32]) {
    // Keep quiet when the body reads another element of the slice.
    for index in 0..values.len().saturating_sub(1) {
        println!("{} {} {}", values[index], values[index + 1], values[0]);
    }
}

fn mutable_slice(values: &mut [i32]) {
    // Keep quiet when the slice can be written through an index.
    for index in 0..values.len().saturating_sub(1) {
        values[index] = values[index + 1];
    }
}

fn mutable_binding(mut values: Vec<i32>) {
    // Keep quiet when the slice binding is mutable.
    for index in 0..values.len().saturating_sub(1) {
        values[index] = values[index + 1];
    }
}

fn window_name(values: &[i32], window: i32) {
    // Keep quiet when the body already uses the window binding name.
    for index in 0..values.len().saturating_sub(1) {
        println!("{} {} {window}", values[index], values[index + 1]);
    }
}

fn window_binding(values: &[i32]) {
    // Keep quiet when the body declares a binding with the window name.
    for index in 0..values.len().saturating_sub(1) {
        let window = values[index];
        println!("{} {}", window, values[index + 1]);
    }
}

fn nonzero_start(values: &[i32]) {
    // Keep quiet when the range does not start at zero.
    for index in 1..values.len().saturating_sub(1) {
        println!("{} {}", values[index], values[index + 1]);
    }
}

fn wider_bound(values: &[i32]) {
    // Keep quiet when the bound subtracts more than one.
    for index in 0..values.len().saturating_sub(2) {
        println!("{} {}", values[index], values[index + 1]);
    }
}

fn other_method(values: &[i32]) {
    // Keep quiet when the bound uses another method.
    for index in 0..values.len().min(1) {
        println!("{} {}", values[index], values[index + 1]);
    }
}

fn string_length(text: &str, values: &[i32]) {
    // Keep quiet when the length belongs to a string.
    for index in 0..text.len().saturating_sub(1) {
        println!("{} {}", values[index], values[index + 1]);
    }
}

struct Holder {
    values: Vec<i32>,
}

fn field_slice(holder: &Holder) {
    // Keep quiet when the slice is not a local binding.
    for index in 0..holder.values.len().saturating_sub(1) {
        println!("{} {}", holder.values[index], holder.values[index + 1]);
    }
}

static VALUES: [i32; 2] = [1, 2];

fn static_slice() {
    // Keep quiet when the slice is not a local binding.
    for index in 0..VALUES.len().saturating_sub(1) {
        println!("{} {}", VALUES[index], VALUES[index + 1]);
    }
}

fn plain_bound(values: &[i32], count: usize) {
    // Keep quiet when the bound is not a method call.
    for index in 0..count {
        println!("{} {}", values[index], values[index + 1]);
    }
}

fn counted_bound(values: &[i32], count: usize) {
    // Keep quiet when the bound does not call `len`.
    for index in 0..count.saturating_sub(1) {
        println!("{} {}", values[index], values[index + 1]);
    }
}

fn inclusive(values: &[i32]) {
    // Keep quiet for an inclusive range.
    for index in 0..=values.len().saturating_sub(2) {
        println!("{} {}", values[index], values[index + 1]);
    }
}

fn reordered_fields(values: &[i32]) {
    // Keep quiet for a struct literal that lists the end first.
    for index in (std::ops::Range {
        end: values.len().saturating_sub(1),
        start: 0,
    }) {
        println!("{} {}", values[index], values[index + 1]);
    }
}

fn mutable_index(values: &[i32]) {
    // Keep quiet when the index binding is mutable.
    for mut index in 0..values.len().saturating_sub(1) {
        println!("{} {}", values[index], values[index + 1]);
    }
}

macro_rules! at {
    ($values:ident, $index:expr) => {
        $values[$index]
    };
}

fn macro_index(values: &[i32]) {
    // Keep quiet when an index expression comes from a macro.
    for index in 0..values.len().saturating_sub(1) {
        println!("{} {}", at!(values, index), values[index + 1]);
    }
}

macro_rules! pairs {
    ($values:ident) => {
        for index in 0..$values.len().saturating_sub(1) {
            println!("{} {}", $values[index], $values[index + 1]);
        }
    };
}

fn generated(values: &[i32]) {
    // Keep quiet for a loop produced by a macro.
    pairs!(values);
}

fn main() {
    adjacent(&[1, 2]);
    let _ = owned(vec![1, 2]);
    let _ = array([1, 2, 3]);
    unsafe_bound(&[1, 2]);
    uses_index(&[1, 2]);
    different_slices(&[1, 2], &[3, 4]);
    repeated_index(&[1, 2]);
    extra_index(&[1, 2]);
    mutable_slice(&mut [1, 2]);
    mutable_binding(vec![1, 2]);
    window_name(&[1, 2], 3);
    window_binding(&[1, 2]);
    nonzero_start(&[1, 2]);
    wider_bound(&[1, 2]);
    other_method(&[1, 2]);
    string_length("ab", &[1, 2]);
    field_slice(&Holder { values: vec![1, 2] });
    static_slice();
    plain_bound(&[1, 2], 1);
    counted_bound(&[1, 2], 1);
    inclusive(&[1, 2]);
    reordered_fields(&[1, 2]);
    mutable_index(&[1, 2]);
    macro_index(&[1, 2]);
    generated(&[1, 2]);
}
