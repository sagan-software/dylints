// run-rustfix
// rustfix-only-machine-applicable
use thiserror::{Error, Error as ThisError};

#[derive(thiserror::Error, Debug)]
pub enum QualifiedRedundantSource {
    #[error("io")]
    Io(
        #[from]
        std::io::Error,
    ),
}

#[derive(Error, Debug)]
pub enum ImportedRedundantSource {
    #[error("io")]
    Io(
        #[from]
        std::io::Error,
    ),
}

#[derive(ThisError, Debug)]
#[error("io")]
pub struct RenamedRedundantSource {
    #[from]
    inner: std::io::Error,
}

mod glob {
    use thiserror::*;

    #[derive(Error, Debug)]
    pub enum GlobRedundantSource {
        #[error("io")]
        Io(
            #[from]
            std::io::Error,
        ),
    }
}

#[derive(ThisError, Debug)]
pub enum FromOnly {
    #[error("io")]
    Io(#[from] std::io::Error),
}

#[derive(ThisError, Debug)]
pub enum SourceOnly {
    #[error("io")]
    Io(#[source] std::io::Error),
}

fn main() {
    let _ = glob::GlobRedundantSource::from(std::io::Error::other("x"));
}
