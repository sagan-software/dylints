// run-rustfix
// rustfix-only-machine-applicable
use schemars::JsonSchema;
use serde::Serialize;

#[derive(JsonSchema, Serialize)]
#[serde(rename_all = "camelCase")]
struct Example {
    bad: String,
    good: String,
}

#[derive(JsonSchema, Serialize)]
struct RenameOnly {
    #[serde(rename = "id")]
    #[schemars(rename = "id")]
    request_id: String,
}

fn main() {}
