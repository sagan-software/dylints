#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"$LLVM_COV_LOG"
if [[ "$*" == *'export --summary-only'* ]]; then
    printf '{"data":[{"files":['
    printf '{"filename":"%s/lints/complexity/chaining_lint_support.rs","summary":{"lines":{"count":1,"covered":1,"percent":100},"regions":{"count":1,"covered":1,"percent":100}}},' "$FAKE_REPOSITORY_ROOT"
    printf '{"filename":"%s/lints/complexity/example/src/../../chaining_lint_support.rs","summary":{"lines":{"count":1,"covered":0,"percent":0},"regions":{"count":1,"covered":0,"percent":0}}},' "$FAKE_REPOSITORY_ROOT"
    printf '{"filename":"%s/src/runner.rs","summary":{"lines":{"count":1,"covered":0,"percent":0},"regions":{"count":1,"covered":0,"percent":0}}}' "$FAKE_REPOSITORY_ROOT"
    printf '],"totals":{"lines":{"count":3,"covered":1,"percent":33.3333333333},"regions":{"count":3,"covered":1,"percent":33.3333333333}}}]}\n'
elif [[ "$*" == *'export --format=lcov'* ]]; then
    printf 'TN:\n'
fi
